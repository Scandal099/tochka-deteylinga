{
  "mcpServers": {
    "shadcn": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "shadcn@latest", "mcp"]
    },
    "magic-ui": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@magicuidesign/mcp@latest"]
    },
    "21st-dev": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "YOUR_21ST_API_KEY"
      }
    }
  }
}
